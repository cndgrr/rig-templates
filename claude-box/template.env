# claude-box — the Claude Code agent tenant (ported byte-equivalent from
# rig's case arms in rig#110; the schema is rig's commands/lib/templates.sh).
USER="claude"
CONTEXT_PATH=".claude/CLAUDE.md"
CLI_NAME="claude"
CLI_SRC="~/.local/bin/claude"
PATH_LINE="export PATH="$HOME/.local/bin:$PATH""
NEEDS_NODE="yes"
APT_EXTRAS="zsh"
