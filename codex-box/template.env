# codex-box — the OpenAI Codex agent tenant (ported byte-equivalent from
# rig's case arms in rig#110). No CLI_SRC on purpose: an npm global's path is
# the prefix's fact, so the mechanism finds the installed CLI via command -v.
USER="codex"
CONTEXT_PATH=".codex/AGENTS.md"
CLI_NAME="codex"
PATH_LINE="export PATH="$(npm prefix -g)/bin:$PATH""
NEEDS_NODE="yes"
